<?xml version="1.0" encoding="utf-8"?>
<!-- The desktop's Dock icon in the default theme: its tinted tile and ribbon. The tile is a dithered PNG because a
     vector gradient this dark bands. Launchers with themed icons (Android 13+) draw
     the monochrome layer in the wallpaper's colours instead. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
