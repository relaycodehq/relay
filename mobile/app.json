{
  "expo": {
    "name": "Relay",
    "slug": "relay-remote",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "relay-remote",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1e1e21",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.relay.remote"
    },
    "android": {
      "package": "dev.relay.remote",
      "adaptiveIcon": {
        "backgroundColor": "#1b1b1f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Relay uses the camera to scan the pairing code on your computer."
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
