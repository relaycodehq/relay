{
  "expo": {
    "name": "Relay",
    "slug": "relay-remote",
    "version": "0.10.3",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "relay-remote",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1e1e21",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.relay.remote"
    },
    "android": {
      "package": "dev.relay.remote",
      "adaptiveIcon": {
        "backgroundColor": "#1b1b1f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1e1e21",
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Relay uses the camera to scan the pairing code on your computer."
        }
      ],
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
