# Merge these routes into your existing site's block. Do not replace other sites.
reviews.example.com {
    redir /review-relay /review-relay/ 308
    handle_path /review-relay/* {
        header {
            Cache-Control "no-store"
            X-Content-Type-Options "nosniff"
            Referrer-Policy "no-referrer"
        }
        reverse_proxy 127.0.0.1:4319
    }
}
