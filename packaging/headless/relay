#!/bin/sh
# Runs the headless Relay with the Node.js on PATH (or RELAY_NODE); it needs 22 or newer.
set -eu
self=$0
# Follow the link ~/.local/bin/relay is, to the install it belongs to.
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
root=$(cd "$(dirname "$self")/.." && pwd -P)
node=${RELAY_NODE:-node}
if ! command -v "$node" >/dev/null 2>&1; then
  echo "Relay needs Node.js 22 or newer: https://nodejs.org/en/download" >&2
  exit 1
fi
exec "$node" "$root/lib/relay.cjs" "$@"
