{
  "name": "relay",
  "productName": "Relay",
  "version": "0.1.0",
  "description": "A project workspace for agent chats, code changes and pull request reviews",
  "author": "Relay contributors",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "node scripts/typecheck.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "electron .",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage tar.gz --x64 --publish never",
    "package:omarchy": "npm run build && electron-builder --linux dir --x64 --publish never && python3 scripts/package-omarchy.py",
    "format": "prettier --write src electron shared server tests scripts *.ts",
    "format:check": "prettier --check src electron shared server tests scripts *.ts",
    "test:triage-live": "node scripts/eval-triage.mjs",
    "test:setup": "npm ci --prefix tests/fixtures/language-toolchain --ignore-scripts",
    "build:server": "node scripts/build-rooms.mjs",
    "start:server": "node dist-server/server.mjs",
    "package:server": "node scripts/package-rooms.mjs",
    "vendor:t3:check": "python3 scripts/update-t3-streaming.py",
    "vendor:t3:update": "python3 scripts/update-t3-streaming.py --update",
    "vendor:cursor": "node scripts/update-cursor-sdk.mjs",
    "test:streaming": "vitest run tests/unit/t3-streaming.test.ts electron/project-chats/project-chats.test.ts",
    "package:win": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.276",
    "@base-ui/react": "1.4.1",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@pierre/diffs": "1.4.3",
    "@pierre/trees": "1.0.0-beta.4",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-virtual": "3.14.13",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "diff": "9.0.0",
    "effect": "4.0.0-rc.115",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.47.0",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sherpa-onnx-node": "1.13.8",
    "uqr": "0.1.3",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cursor/sdk": "1.0.32",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "build": {
    "appId": "dev.relay.experimental",
    "productName": "Relay",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "dist-phone/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "LICENSE",
      "!node_modules/**/*",
      "assets/icon.png",
      "assets/trayTemplate.png",
      "assets/trayTemplate@2x.png"
    ],
    "asar": true,
    "asarUnpack": [
      "dist-electron/node-pty/**",
      "dist-electron/typescript-5/**",
      "dist-electron/sherpa/**",
      "dist-electron/agent-host.mjs",
      "dist-electron/cursor-worker.mjs"
    ],
    "npmRebuild": false,
    "protocols": [
      {
        "name": "Relay project invitation",
        "schemes": [
          "relay-room"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "icon": "assets/icon.icns",
      "identity": "-",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Relay listens while you dictate a message. Speech is transcribed on this computer."
      }
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "assets/icon.png",
      "syncDesktopName": true,
      "executableName": "relay-experimental"
    },
    "compression": "normal",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "background": "build/dmg-background.tiff",
      "iconSize": 100,
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 170,
          "y": 220,
          "type": "file"
        },
        {
          "x": 430,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "shortcutName": "Relay"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  },
  "license": "MIT",
  "desktopName": "relay-experimental.desktop"
}
